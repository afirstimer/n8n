# ─── Copy file này thành .env và điền giá trị thật ───────────────
# cp .env.example .env

# Timezone
TZ=Asia/Ho_Chi_Minh

# ─── PostgreSQL (n8n database) ────────────────────────────────────
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=n8n

# ─── n8n ──────────────────────────────────────────────────────────
N8N_PORT=5678

# Tạo key: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_64_char_hex_key

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_login_password

# Local: http://localhost:5678 | Production: https://n8n.yourdomain.com
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/

N8N_LOG_LEVEL=info

# ─── Cloud AI APIs ────────────────────────────────────────────────
# Provider mặc định: gemini | groq | openrouter | deepseek | openai
AI_DEFAULT_PROVIDER=gemini

# Google Gemini – https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq – https://console.groq.com
GROQ_API_KEY=

# OpenRouter – https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek – https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenAI – https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Hugging Face – https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=


# CODE_SERVER_PASSWORD
CODE_SERVER_PASSWORD=

# MYSQL
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# LITELLM_MASTER_KEY
LITELLM_MASTER_KEY=
