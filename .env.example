# ─── Copy file này thành .env và điền giá trị thật ───────────────
# cp .env.example .env

# Timezone
TZ=Asia/Ho_Chi_Minh

# ─── PostgreSQL (n8n database) ────────────────────────────────────
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=n8n

# ─── Redis (production queue mode) ────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ─── n8n ──────────────────────────────────────────────────────────
# Truy cập qua nginx (:80/:443), không expose port 5678 ra ngoài

# Tạo key: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_64_char_hex_key

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_login_password

# Domain trên OVH (ví dụ: n8n.yourdomain.com)
N8N_HOST=n8n.yourdomain.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.yourdomain.com/
N8N_EDITOR_BASE_URL=https://n8n.yourdomain.com/

N8N_LOG_LEVEL=info

# ─── Cloud AI APIs (bắt buộc – không dùng model local) ──────────
# Provider mặc định cho workflow: gemini | groq | openrouter | deepseek | openai
AI_DEFAULT_PROVIDER=gemini

# Google Gemini (free tier – khuyến nghị cho vietsub/dịch tiếng Việt)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (free tier – Llama/Mixtral, inference nhanh)
# https://console.groq.com
GROQ_API_KEY=

# OpenRouter (nhiều model free: llama, qwen, mistral...)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek (free tier – text/code, tiếng Việt tốt)
# https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenAI (Whisper transcription, GPT – có phí sau free credit)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Hugging Face Inference API (một số model free)
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ─── Backend (tương lai) ──────────────────────────────────────────
BACKEND_PORT=3000
